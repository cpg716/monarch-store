//! Search, Essentials, Trending, and Categories — **one universal output**.
//!
//! All four entry points MUST produce the same Package shape: one card per app, `canonical_id`,
//! `available_sources` (Official, CachyOS, Chaotic, Flatpak, AUR). Details and RepoSelector use
//! that same data. Two implementation paths exist that both satisfy this:
//!
//! 1. **Seed list → full merge**: `fetch_and_merge_packages_by_names_impl` takes `(name, app_id)` seeds,
//!    fetches from repo + Chaotic + Flatpak + AUR, and returns Package with full `available_sources`.
//!    Used by: **Essentials** (get_packages_by_names), **Categories** (get_category_packages_paginated),
//!    and **Trending** (augmentation step so trending cards get same shape).
//!
//! 2. **Raw results → merge**: `merge_search_results` + dedupe take per-source search hits and group
//!    by `canonical_merge_key`, building `available_sources`. Used by: **Search** (search_packages),
//!    and **Trending** (initial merge before augmentation). Same output contract, different input path.

use crate::{
    aur_api, chaotic_api, discovery_manager, metadata, middleware::aggregation, models,
    repo_manager::RepoManager, utils,
};

use moka::future::Cache;
use once_cell::sync::Lazy;
use serde::Serialize;
use specta::Type;
use std::collections::HashMap;
use tauri::State;

// Cache for Trending results (key: (include_flatpak, include_aur, include_chaotic))
// TTL: 15 minutes
static TRENDING_CACHE: Lazy<Cache<(bool, bool, bool), Vec<models::Package>>> = Lazy::new(|| {
    Cache::builder()
        .time_to_live(std::time::Duration::from_secs(60 * 15))
        .build()
});

// Cache for Category Paginated results (key: composite string of params)
// TTL: 6 hours — category contents change slowly; longer TTL avoids refetch when revisiting.
static CATEGORY_CACHE: Lazy<Cache<String, Vec<models::Package>>> = Lazy::new(|| {
    Cache::builder()
        .time_to_live(std::time::Duration::from_secs(6 * 60 * 60))
        .build()
});

/// Clear in-memory search/trending/category caches AND their disk counterparts.
/// Called from Settings "Clear cache" so users see pipeline fixes without restarting the app.
pub fn clear_search_and_list_caches() {
    TRENDING_CACHE.invalidate_all();
    CATEGORY_CACHE.invalidate_all();
    // Delete disk caches so next startup is also fresh
    if let Some(dir) = dirs::cache_dir().map(|d| d.join("monarch-store")) {
        // Remove all category disk caches
        if let Ok(entries) = std::fs::read_dir(&dir) {
            for entry in entries.flatten() {
                let name = entry.file_name();
                let name_str = name.to_string_lossy();
                if (name_str.starts_with("trending_cache_")
                    || name_str.starts_with("category_")
                    || name_str.starts_with("essentials_"))
                    && name_str.ends_with(".json")
                {
                    let _ = std::fs::remove_file(entry.path());
                }
            }
        }
        let _ = std::fs::remove_file(dir.join("essentials_packages_cache.json"));
    }
}

